SUPABASE_SERVICE_ROLE_KEY=""
NEXT_PUBLIC_MAPBOX_TOKEN=""
INFERENCE_BASE_URL="https://api.fireworks.ai/inference/v1"
INFERENCE_API_KEY=""
INFERENCE_MODEL=""
SEARCH_API_KEY=""
ALLOWED_USER_EMAIL=""
ASK_RATE_LIMIT_PER_HOUR=5
